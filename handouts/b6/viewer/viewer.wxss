.hd {
  padding-top: 20rpx;
  padding-bottom: 60rpx;
}

.hd-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 4rpx 22rpx;
}

.hd-head__title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
}

.hd-head__sub {
  font-size: 21rpx;
  color: #9A8F7C;
}

.hd-pages {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hd-page {
  width: 100%;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  overflow: hidden;
}

.hd-foot {
  display: block;
  margin-top: 28rpx;
  text-align: center;
  font-size: 20rpx;
  color: #B3AEA4;
}

.empty {
  margin-top: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty__btn {
  margin-top: 20rpx;
  display: inline-flex;
}

/* 放大查看：movable-view 自带双指缩放，不依赖 previewImage 对 webp 的支持 */
.hd-zoom {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 22, 20, 0.94);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-zoom__area {
  width: 100vw;
  height: 100vh;
}

.hd-zoom__view {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hd-zoom__img {
  width: 100vw;
  height: 100vh;
}

.hd-zoom__tip {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(251, 246, 236, 0.62);
  pointer-events: none;
}
