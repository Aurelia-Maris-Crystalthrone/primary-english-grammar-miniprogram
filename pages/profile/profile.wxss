.me {
  padding-top: 20rpx;
}

.me-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 18rpx 4rpx 30rpx;
}

.me-avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: #F4E9D6;
  position: relative;
  padding: 0;
  margin: 0;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  border: none;
}

.me-avatar::after {
  border: none;
}

.me-avatar__img {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
}

.me-avatar__emoji {
  font-size: 52rpx;
  line-height: 1;
}

.me-avatar__badge {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #2E2A26;
  color: #FBF6EC;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FDFBF7;
}

.me-hero__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.me-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #222222;
  height: 58rpx;
  line-height: 58rpx;
  border: none;
  outline: none;
  background: transparent;
  padding: 0;
}

.me-name__ph {
  color: #C0B5A3;
  font-weight: 600;
}

.me-hero__sub {
  font-size: 21rpx;
  color: #9A8F7C;
}

.me-phone {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 26rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
}

.me-phone__icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: #F5F1E6;
  color: #8A6A46;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.me-phone__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.me-phone__row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.me-phone__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #2E2A26;
}

.me-phone__value {
  font-size: 24rpx;
  color: #A99C88;
}

.me-phone__value--on {
  color: #37634A;
}

.me-phone__desc {
  font-size: 20rpx;
  color: #A99C88;
  line-height: 1.5;
}

.me-phone__btn {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #2E2A26;
  color: #FBF6EC;
  font-size: 24rpx;
  font-weight: 600;
  margin: 0;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-phone__btn::after {
  border: none;
}

.me-phone__unbind {
  font-size: 22rpx;
  color: #A99C88;
  padding: 12rpx 4rpx;
  flex: none;
}

.me-stats {
  display: flex;
  margin-top: 24rpx;
  padding: 28rpx 20rpx;
}

.me-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.me-stat__num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2E2A26;
  font-family: Georgia, "Times New Roman", serif;
  line-height: 1;
}

.me-stat__label {
  font-size: 20rpx;
  color: #9A8F7C;
}

.users {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.user-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 66rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7E2D7;
  font-size: 25rpx;
  color: #5F594F;
}

.user-chip--on {
  background: #2E2A26;
  border-color: #2E2A26;
  color: #FBF6EC;
}

.user-chip__emoji {
  font-size: 26rpx;
}

.user-chip--add {
  border-style: dashed;
  color: #8A6A46;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 34rpx;
}

.entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  border-radius: 24rpx;
}

.entry:active {
  background: #F9F6EF;
}

.entry__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F5F1E6;
  color: #8A6A46;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry__title {
  font-size: 29rpx;
  font-weight: 600;
  color: #222222;
}

.entry__desc {
  font-size: 22rpx;
  color: #9A8F7C;
}

.entry__arrow {
  color: #C0B5A3;
  font-size: 28rpx;
}

.me-remove {
  margin-top: 40rpx;
  text-align: center;
}

.me-remove text {
  font-size: 22rpx;
  color: #B08783;
}

.me-foot {
  display: block;
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #B3AEA4;
  line-height: 1.6;
}
