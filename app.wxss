/* 小学英语语法 · 小程序基础样式
   配色取自网页版：米白纸感底 + 墨黑正文 + 琥珀金强调。 */

page {
  background: #FDFBF7;
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, button, input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
}

/* ---------- 排版 ---------- */
.eyebrow {
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #A2967F;
  text-transform: uppercase;
}

.serif {
  font-family: Georgia, "Times New Roman", "Songti SC", "STSong", serif;
}

.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #222222;
  letter-spacing: -0.5rpx;
}

.title-sm {
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #222222;
}

.muted {
  color: #6F6B63;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.gold {
  color: #8A6A46;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  border-radius: 28rpx;
  padding: 32rpx;
}

.card--soft {
  background: #F7F3EA;
  border-color: #EDE4D3;
}

.card--flat {
  box-shadow: 0 2rpx 0 rgba(34, 34, 34, 0.02);
}

.card + .card {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 44rpx 4rpx 20rpx;
}

.section-head__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.section-head__note {
  font-size: 22rpx;
  color: #9A8F7C;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  border: none;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: #2E2A26;
  color: #FFFFFF;
}

.btn--primary.btn--hover,
.btn--primary:active {
  background: #4A3E2C;
}

.btn--gold {
  background: #8A6A46;
  color: #FFFFFF;
}

.btn--ghost {
  background: #FFFFFF;
  color: #2E2A26;
  border: 1rpx solid #DCD2C0;
}

.btn--ghost:active {
  background: #F5F3EE;
}

.btn--sm {
  height: 68rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
}

.btn--block {
  width: 100%;
}

.btn[disabled] {
  background: #E7E2D7;
  color: #A39C8F;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ---------- 标签 ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #6F6B63;
  background: #F5F3EE;
}

.pill--gold {
  color: #7A5C33;
  background: #F4E9D6;
}

.pill--green {
  color: #37634A;
  background: #E9F1E7;
}

.pill--red {
  color: #9E403C;
  background: #FBEAE8;
}

.pill--outline {
  background: transparent;
  border: 1rpx solid #E0D7C6;
}

/* ---------- 进度条 ---------- */
.progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: #EFE9DD;
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  border-radius: 999rpx;
  background: #B9975B;
}

/* ---------- 通用 ---------- */
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row--between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack-8 > view + view {
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: #F0EBE1;
  margin: 24rpx 0;
}

.link {
  color: #8A6A46;
  font-weight: 600;
}

.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #9A8F7C;
}

.empty__title {
  font-size: 30rpx;
  color: #4A443C;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}

/* ---------- 未开放学段的统一占位（templates/stage-gate.wxml） ---------- */
.stage-gate {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 56rpx 34rpx;
}

.stage-gate__tag {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
  color: #8A6A46;
}

.stage-gate__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2E2A26;
}

.stage-gate__desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: #7A7368;
}

.stage-gate__btn {
  margin-top: 12rpx;
  align-self: flex-start;
}
