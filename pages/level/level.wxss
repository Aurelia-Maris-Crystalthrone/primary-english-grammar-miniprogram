.level {
  padding-top: 20rpx;
}

.level__top {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 4rpx 26rpx;
}

.level__crumb {
  font-size: 22rpx;
  color: #9A8F7C;
}

.level__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 4rpx;
}

.level__title {
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -1rpx;
  flex: 1;
}

.level__head .pill {
  margin-top: 10rpx;
  flex: none;
}

.rule {
  padding-bottom: 26rpx;
}

.rule__item {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.rule__name {
  font-size: 27rpx;
  font-weight: 700;
  color: #2E2A26;
}

.rule__text {
  font-size: 25rpx;
  color: #5F594F;
  line-height: 1.65;
}

.lesson__rule {
  display: block;
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #33302A;
}

.lesson__scenes {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #F8F4EA;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.scene {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.scene__en {
  font-size: 27rpx;
  color: #2E2A26;
  font-family: Georgia, "Times New Roman", serif;
}

.scene__zh {
  font-size: 22rpx;
  color: #8C8478;
}

.lesson__contrast {
  margin-top: 20rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid #D9C49A;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.lesson__contrast-label {
  font-size: 20rpx;
  color: #A2967F;
  letter-spacing: 2rpx;
}

.lesson__contrast-text {
  font-size: 24rpx;
  color: #5F594F;
  line-height: 1.6;
}

.setup__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.setup__title {
  font-size: 28rpx;
  font-weight: 700;
}

.setup__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #8A6A46;
}

.setup__hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8F7C;
  line-height: 1.6;
}

.round {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 26rpx 0 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #F8F4EA;
  border: 1rpx solid #EDE4D3;
}

.round__left {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: none;
}

.round__num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: #2E2A26;
  font-family: Georgia, "Times New Roman", serif;
}

.round__unit {
  font-size: 22rpx;
  color: #9A8F7C;
}

.round__right {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.round__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2E2A26;
}

.round__desc {
  font-size: 21rpx;
  line-height: 1.5;
  color: #8C8478;
}

.handout {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
}

.handout:active {
  background: #FAF7F1;
}

.handout__icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: #F4E9D6;
  color: #7A5C33;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.handout__body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  flex: 1;
}

.handout__title {
  font-size: 27rpx;
  font-weight: 700;
  color: #2E2A26;
}

.handout__desc {
  font-size: 21rpx;
  color: #9A8F7C;
}

.handout__arrow {
  font-size: 26rpx;
  color: #B9975B;
}

.setup__btn {
  margin-top: 4rpx;
}

.setup__tip {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A99C88;
  line-height: 1.6;
}

.level__nav {
  display: flex;
  gap: 16rpx;
  margin-top: 26rpx;
}

.level__nav-btn {
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.level__nav-btn--right {
  align-items: flex-end;
  text-align: right;
}

.level__nav-btn--off {
  opacity: 0.4;
}

.level__nav-btn--locked {
  opacity: 0.55;
  border-style: dashed;
}

.level__nav-btn--locked .level__nav-dir {
  color: #B3A995;
}

.level__nav-dir {
  font-size: 20rpx;
  color: #A2967F;
}

.level__nav-name {
  font-size: 25rpx;
  color: #2E2A26;
  font-weight: 600;
}

.level__back {
  margin-top: 34rpx;
  text-align: center;
}

.level__back text {
  font-size: 24rpx;
  color: #8A6A46;
  border-bottom: 1rpx solid #D9C49A;
  padding-bottom: 2rpx;
}
