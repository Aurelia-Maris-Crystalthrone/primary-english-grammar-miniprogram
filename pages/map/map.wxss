.map {
  padding-top: 20rpx;
}

.map-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 4rpx 26rpx;
}

.map-head__title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.map-head__sub {
  font-size: 23rpx;
  color: #8C8478;
  line-height: 1.6;
}

.stages {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx 8rpx;
}

.stage {
  display: inline-flex;
  flex-direction: column;
  width: 200rpx;
  margin-right: 16rpx;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  vertical-align: top;
}

.stage--active {
  background: #2E2A26;
  border-color: #2E2A26;
}

.stage__book {
  font-size: 20rpx;
  color: #A99C88;
  letter-spacing: 1rpx;
}

.stage--active .stage__book {
  color: #C8B291;
}

.stage__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  margin-top: 4rpx;
}

.stage--active .stage__name {
  color: #FBF6EC;
}

.stage__bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: #EFE9DD;
  margin: 16rpx 0 10rpx;
  overflow: hidden;
}

.stage--active .stage__bar {
  background: rgba(255, 255, 255, 0.18);
}

.stage__bar-in {
  height: 100%;
  background: #B9975B;
  border-radius: 999rpx;
}

.stage__count {
  font-size: 21rpx;
  color: #9A8F7C;
}

.stage--active .stage__count {
  color: #B9AC97;
}

.stage-note {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #F6F1E6;
  border: 1rpx solid #EDE3D0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.stage-note__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6B5836;
}

.stage-note__desc {
  font-size: 22rpx;
  color: #8C7B5F;
  line-height: 1.6;
}

.phase {
  margin-top: 36rpx;
}

.phase__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}

.phase__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.phase__meta {
  font-size: 21rpx;
  color: #9A8F7C;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.node {
  width: calc(50% - 8rpx);
  min-height: 220rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.node:active {
  background: #F9F6EF;
}

.node--cleared {
  background: #FBF7EC;
  border-color: #E9DCC0;
}

.node--locked {
  background: #F7F5F0;
  border-color: #EDE8DE;
  border-style: dashed;
}

.node--locked .node__num {
  background: #EAE5DA;
  color: #B3A995;
}

.node--locked .node__name {
  color: #9C9384;
}

.node--locked .node__meta {
  color: #B0A794;
}

.node--exam {
  background: #2E2A26;
  border-color: #2E2A26;
}

.node__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.node__num {
  min-width: 52rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #F5F1E6;
  color: #8A6A46;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.node--cleared .node__num {
  background: #B9975B;
  color: #FFFFFF;
}

.node--exam .node__num {
  background: rgba(230, 211, 174, 0.16);
  color: #E6D3AE;
}

.node__tag {
  font-size: 19rpx;
  color: #A99C88;
}

.node--exam .node__tag {
  color: #C8B291;
}

.node__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.45;
  min-height: 78rpx;
}

.node--exam .node__name {
  color: #FBF6EC;
}

.node__meta {
  font-size: 20rpx;
  color: #A99C88;
}

.node--exam .node__meta {
  color: #A99C88;
}

.map-foot {
  margin-top: 40rpx;
  padding: 0 8rpx;
  text-align: center;
}

.map-foot__text {
  font-size: 21rpx;
  color: #B3AEA4;
  line-height: 1.6;
}
