.home {
  padding-top: 16rpx;
}

.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 32rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand__mark {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
  border: 2rpx solid #2E2A26;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #2E2A26;
}

.brand__text {
  display: flex;
  flex-direction: column;
}

.brand__name {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand__sub {
  font-size: 20rpx;
  color: #9A8F7C;
  letter-spacing: 2rpx;
}

.brand__date {
  font-size: 22rpx;
  color: #9A8F7C;
}

.today {
  padding: 36rpx 32rpx 30rpx;
}

.today__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 10rpx;
}

.today__title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  color: #222222;
}

.today__percent {
  font-size: 30rpx;
  font-weight: 700;
  color: #8A6A46;
}

.today__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6F6B63;
}

.today__bar {
  margin: 24rpx 0 28rpx;
}

.today__stats {
  display: flex;
  border-top: 1rpx solid #F0EBE1;
  padding-top: 24rpx;
}

.today__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.today__stat + .today__stat {
  border-left: 1rpx solid #F0EBE1;
  padding-left: 24rpx;
}

.today__num {
  font-size: 38rpx;
  font-weight: 700;
  color: #2E2A26;
  line-height: 1.2;
}

.today__unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #6F6B63;
}

.today__label {
  font-size: 20rpx;
  color: #9A8F7C;
  letter-spacing: 1rpx;
}

.mission {
  margin-top: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2E2A26 0%, #4A3E2C 100%);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.mission__eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #C8B291;
  font-weight: 600;
}

.mission__level {
  font-size: 22rpx;
  color: #B9AC97;
  margin-top: 4rpx;
}

.mission__name {
  font-size: 44rpx;
  font-weight: 700;
  color: #FBF6EC;
  line-height: 1.3;
  margin-top: 2rpx;
}

.mission__reason {
  font-size: 25rpx;
  line-height: 1.65;
  color: #D8CDBB;
  margin-top: 4rpx;
}

.mission__foot {
  margin-top: 26rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mission__meta {
  font-size: 21rpx;
  color: #A99C88;
}

.mission__btn {
  flex: none;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #E6D3AE;
  color: #3A2F1F;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.entries {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #EFE9DD;
  border-radius: 24rpx;
}

.entry:active {
  background: #F9F6EF;
}

.entry__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F5F1E6;
  color: #8A6A46;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry__title {
  font-size: 29rpx;
  font-weight: 600;
  color: #222222;
}

.entry__desc {
  font-size: 22rpx;
  color: #9A8F7C;
}

.entry__arrow {
  color: #C0B5A3;
  font-size: 28rpx;
}

.promo {
  margin-top: 44rpx;
  padding: 0;
  overflow: hidden;
  background: #FDFBF7;
}

/* 1. 顶部导航条 */
.promo__nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 20rpx;
  background: #2F3A42;
}

.promo__nav-brand {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  white-space: nowrap;
}

.promo__nav-menu {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  white-space: nowrap;
}

.promo__nav-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
}

.promo__nav-item {
  font-size: 20rpx;
  color: #A9B6BE;
  white-space: nowrap;
}

/* 2. 网站截图承载区 */
.promo__shot {
  background: #FBF6EC;
}

.promo__shot-img {
  width: 100%;
  display: block;
}

/* 3. 品牌标题 */
.promo__body {
  padding: 40rpx 28rpx 28rpx;
}

.promo__brand {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2F1F;
}

/* 4. 特点标签 */
.promo__panel {
  margin-top: 30rpx;
  padding: 24rpx 18rpx;
  border: 1rpx solid #E4D6BE;
  border-radius: 18rpx;
  background: #F7F3EA;
}

.promo__tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}

.promo__tag {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #F1E9DB;
  color: #7A5C33;
  font-size: 22rpx;
}

/* 5. 课程网格 */
.promo__grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 26rpx;
}

.promo__cell {
  height: 112rpx;
  padding: 0 12rpx;
  border: 1rpx solid #E4D6BE;
  border-radius: 16rpx;
  background: #F7F3EA;
  color: #3A2F1F;
  font-size: 27rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promo__badge {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 88rpx;
  height: 88rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #8A6A46;
  color: #FBF6EC;
  font-size: 23rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 6. 方向说明 */
.promo__note {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9A8F7C;
}

/* 7. 复制链接按钮 */
.promo__btn {
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 14rpx;
  background: #8A6A46;
  color: #FFFDF8;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promo__btn:active {
  background: #755732;
}

.foot {
  display: block;
  text-align: center;
  margin-top: 44rpx;
  font-size: 21rpx;
  color: #B3AEA4;
  letter-spacing: 1rpx;
}

/* ---------- 阶段选择（一级 + 大学二级 + 考研三级） ---------- */
.stage-picker {
  margin-bottom: 28rpx;
  padding: 20rpx 18rpx 18rpx;
  border: 1rpx solid #EFE9DD;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.stage-picker__row {
  width: 100%;
  white-space: nowrap;
}

.stage-picker__item {
  display: inline-block;
  min-width: 120rpx;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  border: 1rpx solid #EFE9DD;
  border-radius: 16rpx;
  background: #FDFBF7;
  text-align: center;
  vertical-align: middle;
}

.stage-picker__item:active {
  background: #F5F1E6;
}

.stage-picker__name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #6F6B63;
}

.stage-picker__badge {
  display: block;
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #B3AEA4;
}

.stage-picker__item--active {
  border-color: #2E2A26;
  background: #2E2A26;
}

.stage-picker__item--active .stage-picker__name {
  color: #FBF6EC;
}

.stage-picker__item--active .stage-picker__badge {
  color: #C8B291;
}

.stage-picker__subs {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #EFE9DD;
}

.stage-picker__sub {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #EFE9DD;
  border-radius: 16rpx;
  background: #FDFBF7;
}

.stage-picker__sub--active {
  border-color: #8A6A46;
  background: #F9F3E6;
}

.stage-picker__sub-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2E2A26;
}

.stage-picker__sub-desc {
  font-size: 20rpx;
  color: #9A8F7C;
}

.stage-picker__children {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #EFE9DD;
}

.stage-picker__children-label {
  font-size: 20rpx;
  color: #9A8F7C;
}

.stage-picker__child {
  padding: 10rpx 22rpx;
  border: 1rpx solid #EFE9DD;
  border-radius: 999rpx;
  background: #FDFBF7;
  font-size: 23rpx;
  color: #6F6B63;
}

.stage-picker__child--active {
  border-color: #8A6A46;
  background: #F9F3E6;
  color: #5B452C;
}

.stage-picker__note {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #9A8F7C;
}

/* ---------- 当前学段内容归属 ---------- */
.stage-owner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 4rpx 0 24rpx;
}

.stage-owner__tag {
  flex: none;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F0DA;
  color: #4E6B32;
  font-size: 21rpx;
  font-weight: 600;
}

.stage-owner__text {
  font-size: 21rpx;
  color: #8A8375;
}

/* ---------- 语法地图分类卡片 ---------- */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.cat {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 22rpx;
  border: 1rpx solid #EFE9DD;
  border-radius: 22rpx;
  background: #FFFFFF;
}

.cat:active {
  background: #F9F6EF;
}

.cat__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat__icon {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #F5F1E6;
  color: #8A6A46;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cat__title {
  font-size: 25rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.35;
}

.cat__meta {
  font-size: 20rpx;
  color: #9A8F7C;
}

.cat__bar {
  margin: 6rpx 0 2rpx;
}

.cat__progress {
  font-size: 19rpx;
  color: #8A6A46;
}

/* ---------- 未开放学段 ---------- */
.stage-empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  padding: 56rpx 34rpx;
}

.stage-empty__eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  color: #8A6A46;
}

.stage-empty__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2E2A26;
}

.stage-empty__desc {
  font-size: 24rpx;
  line-height: 1.75;
  color: #7A7368;
}

.stage-empty__btn {
  margin-top: 12rpx;
  align-self: flex-start;
}
